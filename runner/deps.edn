{:paths ["src" "resources"]
 :deps {aero/aero {:mvn/version "1.1.6"}
        ch.qos.logback/logback-classic {:mvn/version "1.6.5"}
        com.rabbitmq/stream-client {:mvn/version "1.12.0"}
        common/common {:local/root "../common"}
        failjure/failjure {:mvn/version "2.3.70"}
        integrant/integrant {:mvn/version "1.0.1"}
        io.github.lispyclouds/contajners {:git/sha "31ce1cd12a04fb5ac0e32a0a20e5d660e80fe786"}
        org.babashka/http-client {:mvn/version "0.4.25"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        org.kamranzafar/jtar {:mvn/version "2.3"}}
 :aliases {:test {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               org.clojure/test.check {:mvn/version "1.1.3"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "kaocha.runner"]
                  :jvm-opts ["--enable-preview"]}
           :repl {:extra-deps {nrepl/nrepl {:mvn/version "RELEASE"}
                               cider/cider-nrepl {:mvn/version "RELEASE"}}
                  :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]
                  :jvm-opts ["--enable-preview"]}
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
                   :ns-default build}}}
